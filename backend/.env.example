# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-or-publishable-key
SUPABASE_ANON_KEY=sb_anon_xxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend URLs
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# AI Verification
AI_SCORE_THRESHOLD=0.85

# Authentication
DEMO_AUTH_ENABLED=true

# OAuth Providers (for social account linking)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Solana Configuration
KERN_SOLANA_CLUSTER=devnet
KERN_SOLANA_RPC_URL=https://api.devnet.solana.com
KERN_PROGRAM_ID=your-program-id
KERN_TREASURY_PUBKEY=your-treasury-pubkey
KERN_SOLANA_KEYPAIR_PATH=~/.config/solana/id.json
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json

# Cron Job Configuration
KERN_CRON_MODE=demo
